{
  "name": "idd-cli",
  "version": "0.1.0",
  "description": "IDD IDE — Interface de linha de comando",
  "bin": {
    "idd": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --external:better-sqlite3 --external:typescript",
    "watch": "tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@idd/core": "file:../packages/core",
    "better-sqlite3": "^13.0.3",
    "chalk": "^5.3.0",
    "js-yaml": "^4.3.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^9.0.7",
    "esbuild": "^0.28.2",
    "sql.js": "^1.14.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  }
}
