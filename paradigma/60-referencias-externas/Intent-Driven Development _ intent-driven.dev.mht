------MultipartBoundary--Ot3bZbDUROdcxHt0QtBAxHmTL0okXtcrxhdgZZy5Eg----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://intent-driven.dev/styles/main.css

@charset "utf-8";

@font-face { font-family: "Space Grotesk"; font-style: normal; font-weight: 500; font-display: swap; src: url("/assets/fonts/space-grotesk-500.woff2") format("woff2"); }

@font-face { font-family: "Space Grotesk"; font-style: normal; font-weight: 700; font-display: swap; src: url("/assets/fonts/space-grotesk-700.woff2") format("woff2"); }

:root { --color-primary: #2563eb; --color-primary-dark: #1e40af; --color-text: #1f2937; --color-text-light: #6b7280; --color-background: #ffffff; --color-background-alt: #f9fafb; --color-border: #e5e7eb; --color-infoq: #C0003E; --ink: #0B1220; --ink-2: #131C2E; --ink-line: #243049; --ink-muted: #8A97AD; --signal: #3B6CFF; --signal-dark: #2a52cc; --verified: #22C55E; --cta-consulting-bg: #f9fafb; --cta-consulting-border: #e5e7eb; --cta-consulting-highlight: var(--color-primary); --font-family-base: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; --font-display: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; --font-mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace; --font-size-base: 16px; --line-height-base: 1.6; --spacing-xs: 0.5rem; --spacing-sm: 1rem; --spacing-md: 1.5rem; --spacing-lg: 2rem; --spacing-xl: 3rem; --spacing-2xl: 4rem; --spacing-3xl: 6rem; --max-width: 1200px; --max-width-content: 800px; --transition-fast: 150ms ease-in-out; --transition-base: 300ms ease-in-out; }

*, ::before, ::after { box-sizing: border-box; margin: 0px; padding: 0px; }

html { scroll-behavior: smooth; }

body { font-family: var(--font-family-base); font-size: var(--font-size-base); line-height: var(--line-height-base); color: var(--color-text); background-color: var(--color-background); -webkit-font-smoothing: antialiased; }

main { display: block; }

.skip-link { position: absolute; top: -100px; left: 50%; transform: translateX(-50%); background: var(--color-primary); color: white; padding: var(--spacing-sm) var(--spacing-lg); text-decoration: none; border-radius: 0px 0px 8px 8px; font-weight: 600; font-size: 0.875rem; box-shadow: rgba(0, 0, 0, 0.15) 0px 4px 12px; z-index: 1000; transition: top var(--transition-fast); }

.skip-link:focus { top: 0px; outline: rgba(255, 255, 255, 0.8) solid 3px; outline-offset: 2px; }

.site-header { background: white; border-bottom: 1px solid var(--color-border); position: sticky; top: 0px; z-index: 100; box-shadow: rgba(0, 0, 0, 0.05) 0px 1px 3px; margin-bottom: 0px; }

.site-nav { max-width: var(--max-width); margin: 0px auto; padding: var(--spacing-md) var(--spacing-lg); display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-lg); }

.site-logo { font-size: 1.25rem; font-weight: 700; color: var(--color-primary); text-decoration: none; white-space: nowrap; display: inline-block; line-height: 0; }

.site-logo:hover { color: var(--color-primary-dark); opacity: 0.85; }

.site-logo-image { display: block; height: auto; max-height: 50px; width: auto; transition: opacity var(--transition-fast); }

@media (max-width: 768px) {
  .site-logo-image { max-height: 40px; }
}

.nav-links { display: flex; align-items: center; gap: var(--spacing-lg); list-style: none; }

.nav-link { color: var(--color-text); text-decoration: none; font-weight: 500; font-size: 0.9375rem; transition: color var(--transition-fast); white-space: nowrap; }

.nav-link:hover { color: var(--color-primary); }

.nav-link-icon { display: inline-flex; align-items: center; gap: var(--spacing-xs); color: var(--color-text-light); }

.nav-link-icon svg { width: 18px; height: 18px; }

.nav-link-icon:hover { color: var(--color-primary); }

.nav-toggle { display: none; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; padding: 11px 9px; background: transparent; border: 1px solid var(--color-border); border-radius: 8px; cursor: pointer; }

.nav-toggle-bar { display: block; width: 100%; height: 2px; background: var(--color-text); border-radius: 2px; transition: transform var(--transition-fast), opacity var(--transition-fast); }

.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }

.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) { opacity: 0; }

.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

.nav-toggle:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }

@media (max-width: 768px) {
  .site-nav { padding: var(--spacing-sm) var(--spacing-md); flex-wrap: wrap; gap: var(--spacing-sm); }
  .nav-links { gap: var(--spacing-sm); flex-wrap: wrap; justify-content: center; width: 100%; }
  .nav-link { font-size: 0.8125rem; padding: var(--spacing-xs); min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }
  .nav-link-icon { font-size: 0.8125rem; }
  .site-nav:has(.nav-toggle) { position: relative; flex-wrap: nowrap; }
  .site-nav:has(.nav-toggle) .nav-toggle { display: flex; }
  .site-nav:has(.nav-toggle) .nav-links { position: absolute; top: calc(100% + 1px); left: 0px; right: 0px; flex-direction: column; align-items: stretch; justify-content: flex-start; gap: 0px; width: auto; background: rgb(255, 255, 255); border-bottom: 1px solid var(--color-border); box-shadow: rgba(0, 0, 0, 0.08) 0px 12px 20px; padding: var(--spacing-xs) var(--spacing-md) var(--spacing-md); display: none; }
  .site-nav:has(.nav-toggle).nav-open .nav-links { display: flex; }
  .site-nav:has(.nav-toggle) .nav-link { width: 100%; justify-content: flex-start; font-size: 1rem; padding: 0 var(--spacing-xs); border-bottom: 1px solid var(--color-border); }
  .site-nav:has(.nav-toggle) .nav-links > li:last-child .nav-link { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }
}

@media (max-width: 480px) {
  .site-nav { padding: var(--spacing-xs) var(--spacing-sm); }
  .site-logo-image { max-height: 32px; }
  .nav-links { gap: 0.375rem; }
  .nav-link { font-size: 0.75rem; padding: 0.375rem; }
  .nav-link-icon svg { width: 16px; height: 16px; }
}

.construction-notice { background: linear-gradient(135deg, rgb(254, 243, 199) 0%, rgb(253, 230, 138) 100%); border-bottom: 1px solid rgb(251, 191, 36); padding: var(--spacing-sm) var(--spacing-md); }

.construction-content { max-width: var(--max-width); margin: 0px auto; display: flex; align-items: center; justify-content: center; gap: var(--spacing-sm); }

.construction-icon { flex-shrink: 0; color: rgb(217, 119, 6); }

.construction-text { margin: 0px; font-size: 0.875rem; color: rgb(146, 64, 14); text-align: center; }

.construction-text strong { font-weight: 700; color: rgb(120, 53, 15); }

@media (min-width: 768px) {
  .construction-text { font-size: 1rem; }
}

.hero { min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: var(--spacing-lg); background: linear-gradient(135deg, rgb(102, 126, 234) 0%, rgb(118, 75, 162) 100%); color: white; }

.hero-content { max-width: var(--max-width-content); text-align: center; }

.hero h1 { font-size: 2rem; font-weight: 700; line-height: 1.2; margin-bottom: var(--spacing-md); }

.hero-description { font-size: 1.125rem; line-height: 1.6; margin-bottom: var(--spacing-xl); opacity: 0.95; }

.cta-buttons { display: flex; flex-direction: column; gap: var(--spacing-md); align-items: center; justify-content: center; }

.cta-button { display: inline-flex; align-items: center; justify-content: center; gap: var(--spacing-xs); padding: var(--spacing-md) var(--spacing-xl); font-size: 1.125rem; font-weight: 600; color: var(--color-primary); background-color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 8px; cursor: pointer; text-decoration: none; transition: transform var(--transition-fast), box-shadow var(--transition-fast); min-width: 44px; min-height: 44px; }

.cta-button:hover { transform: translateY(-2px); box-shadow: rgba(0, 0, 0, 0.2) 0px 10px 25px; }

.cta-button:focus { outline: rgba(255, 255, 255, 0.5) solid 3px; outline-offset: 4px; }

.cta-button:active { transform: translateY(0px); }

.cta-button-secondary { background-color: transparent; color: white; border: 2px solid white; }

.cta-button-secondary:hover { background-color: rgba(255, 255, 255, 0.1); border-color: white; }

@media (min-width: 640px) {
  .cta-buttons { flex-direction: row; }
}

.hero-ce { position: relative; min-height: 64vh; display: flex; align-items: center; justify-content: flex-start; padding: var(--spacing-3xl) var(--spacing-lg); overflow: hidden; background: var(--ink); margin-top: 0px; }

.hero-ce-bg { position: absolute; inset: 0px; pointer-events: none; background-image: linear-gradient(var(--ink-line) 1px, transparent 1px),
    linear-gradient(90deg, var(--ink-line) 1px, transparent 1px); background-size: 48px 48px; opacity: 0.25; mask-image: radial-gradient(120% 90% at 15% 30%, rgb(0, 0, 0) 0%, transparent 70%); }

.hero-ce-content { position: relative; z-index: 1; width: 100%; max-width: var(--max-width); margin: 0px auto; text-align: left; color: rgb(255, 255, 255); }

.hero-ce-eyebrow { font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: 0.04em; color: var(--ink-muted); margin-bottom: var(--spacing-md); }

.hero-ce-title { font-family: var(--font-display); font-size: clamp(2.5rem, 6vw, 4.25rem); font-weight: 700; line-height: 1.05; margin-bottom: var(--spacing-md); letter-spacing: -0.03em; max-width: 16ch; }

.hero-ce-title-highlight { position: relative; color: var(--signal); white-space: nowrap; }

.hero-ce-title-highlight::after { content: ""; position: absolute; bottom: 0.06em; left: 0px; right: 0px; height: 3px; background: var(--signal); opacity: 0.55; border-radius: 2px; }

.hero-ce-description { font-size: clamp(1rem, 2vw, 1.1875rem); line-height: 1.7; margin-bottom: var(--spacing-xl); color: rgba(255, 255, 255, 0.78); max-width: 56ch; font-weight: 400; }

.hero-pipeline { display: flex; align-items: center; flex-wrap: wrap; gap: var(--spacing-xs); list-style: none; margin: 0 0 var(--spacing-2xl); padding: 0px; }

.pipeline-step { display: flex; }

.pipeline-chip { display: inline-block; font-family: var(--font-mono); font-size: 0.9375rem; color: rgb(232, 237, 247); background: var(--ink-2); border: 1px solid var(--ink-line); border-radius: 7px; padding: 0.4rem 0.85rem; white-space: nowrap; }

.pipeline-chip-accent { color: var(--verified); border-color: rgba(34, 197, 94, 0.4); background: rgba(34, 197, 94, 0.08); }

.pipeline-arrow { font-family: var(--font-mono); color: var(--ink-muted); font-size: 1rem; }

.cta-buttons-ce { display: flex; gap: var(--spacing-md); justify-content: flex-start; flex-wrap: wrap; }

.cta-button-ce { display: inline-flex; align-items: center; justify-content: center; padding: var(--spacing-md) var(--spacing-xl); font-size: 1.125rem; font-weight: 600; border-radius: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; transition: transform var(--transition-base), box-shadow var(--transition-base); text-decoration: none; white-space: nowrap; min-width: 44px; min-height: 44px; }

.cta-button-ce-primary { background: var(--signal); color: rgb(255, 255, 255); box-shadow: rgba(59, 108, 255, 0.35) 0px 4px 16px; }

.cta-button-ce-primary:hover { background: var(--signal-dark); transform: translateY(-2px); box-shadow: rgba(59, 108, 255, 0.45) 0px 6px 22px; }

.cta-button-ce-primary:active { transform: translateY(0px); }

.cta-button-ce-secondary { background: transparent; color: rgb(255, 255, 255); border: 1px solid rgba(255, 255, 255, 0.28); }

.cta-button-ce-secondary:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.5); transform: translateY(-2px); }

.cta-button-ce-secondary:active { transform: translateY(0px); }

@media (max-width: 768px) {
  .hero-ce { min-height: auto; padding: var(--spacing-2xl) var(--spacing-md); }
  .cta-buttons-ce { flex-direction: column; align-items: stretch; }
  .cta-button-ce { width: 100%; }
}

@media (max-width: 480px) {
  .hero-ce-title { font-size: clamp(2rem, 9vw, 2.75rem); }
  .pipeline-chip { font-size: 0.8125rem; padding: 0.35rem 0.6rem; }
}

.featured-content > h2, .events-content > h2, .insights-content > h2, .enterprise-sdd-content > h2, .video-tutorials-heading { font-family: var(--font-display); letter-spacing: -0.02em; }

.section-eyebrow { display: block; font-family: var(--font-mono); font-size: 0.8125rem; letter-spacing: 0.04em; color: var(--signal); margin-bottom: var(--spacing-xs); }

.featured-section { padding: var(--spacing-3xl) var(--spacing-lg); background: linear-gradient(rgb(255, 255, 255) 0%, rgb(248, 250, 252) 100%); scroll-margin-top: 80px; }

.featured-content { max-width: var(--max-width); margin: 0px auto; }

.featured-section h2 { font-size: 2rem; font-weight: 700; margin-bottom: var(--spacing-md); color: var(--color-text); text-align: center; line-height: 1.3; }

.featured-highlight { color: var(--signal); }

.featured-description { font-size: 1.125rem; line-height: 1.7; color: var(--color-text-light); margin-bottom: var(--spacing-xl); text-align: center; max-width: var(--max-width-content); margin-left: auto; margin-right: auto; }

.featured-description strong { color: var(--color-text); font-weight: 600; }

