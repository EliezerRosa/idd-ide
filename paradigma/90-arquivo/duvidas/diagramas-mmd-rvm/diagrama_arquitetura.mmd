flowchart TD
    %% Actors and Inputs
    User(["User / Elder"])
    Excel(["input: Excel / Life & Ministry"])

    subgraph "Frontend Layer (React)"
        direction TB
        WM["WorkbookManager"]
        GM["GenerationModal"]
        PS["PublisherSelect"]
        style WM fill:#eef2ff,stroke:#4f46e5
        
        subgraph "Specialized Managers"
            SEM["SpecialEventsManager"]
            LNQ["LocalNeedsQueue"]
            Ag["AI Agent Interface"]
        end
    end

    subgraph "Service Layer (Business Logic)"
        WS["WorkbookService"]
        GS["GenerationService"]
        URS["UnifiedRotationService"]
        UAS["UnifiedActionService"]
        SES["SpecialEventService"]
        LNS["LocalNeedsService"]
        CB["ContextBuilder"]
        HA["HistoryAdapter"]
        CS["CooldownService"]
        
        style GS fill:#dcfce7,stroke:#16a34a
        style URS fill:#dcfce7,stroke:#16a34a
        style CS fill:#fde68a,stroke:#d97706
    end

    subgraph "Data Layer (Supabase)"
        TbParts[("workbook_parts")]
        TbPubs[("publishers")]
        TbEvents[("special_events")]
        TbLN[("local_needs_reqs")]
        
        style TbParts fill:#f3f4f6,stroke:#374151
    end

    %% Flow: Data Ingestion
    User -->|"1. Uploads Batch"| Excel
    Excel -->|"Parse & Import"| WM
    WM -->|"Save Batch"| WS
    WS -->|"Insert/Update"| TbParts

    %% Flow: Auto-Generation
    User -->|"2. Triggers Generate"| GM
    GM -->|"Execute (Phase 1-3)"| GS
    GS -->|"Request Candidates"| TbPubs
    GS -->|"Rank by Score"| URS
    GS -->|"Check Block"| CS
    URS -->|"Fetch History"| HA
    URS -->|"Check Penalty"| CS
    CS -.->|"Read Filtered"| HA
    HA -->|"Select Rows"| TbParts
    GS -->|"Commit Assignments"| WS

    %% Flow: Manual Override
    User -->|"3. Manual Adjust"| PS
    PS -->|"Execute Single Change"| UAS
    UAS -->|"Update Status"| WS
    WS -->|"Save"| TbParts

    %% Flow: Special Events
    User -->|"4. Manage Event"| SEM
    SEM -->|"Create/Cancel"| SES
    SES -->|"Modify Parts (Cancel/Add)"| TbParts
    SES -->|"Store Event"| TbEvents

    %% Flow: Local Needs
    User -->|"Queue Request"| LNQ
    LNQ -->|"Store Request"| LNS
    LNS -->|"Fetch"| TbLN
    GS -.->|"Check Pre-Assignments"| LNS

    %% Flow: AI Interaction
    User -->|"Chat Query"| Ag
    Ag -->|"Build Context"| CB
    CB -->|"Fetch State"| TbParts
    CB -->|"Fetch Rules"| URS

    %% Flow: Analytics
    HA -->|"Generate Report"| WM
