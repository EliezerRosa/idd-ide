{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "rootDir": "src",
    "outDir": "out",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "jsx": "react-jsx"
  },
  "include": ["src/extension.ts", "src/sidebar/**/*.ts", "src/diagnostics/**/*.ts", "src/contracts/**/*.ts", "src/webview/ContractDetailPanel.ts"],
  "exclude": ["node_modules", "out", "media"]
}